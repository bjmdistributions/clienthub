{
    "$schema":  "../gen/schemas/desktop-schema.json",
    "identifier":  "default",
    "description":  "Default permissions for ClientHub",
    "windows":  [
                    "main"
                ],
    "permissions":  [
                        "core:default",
                        "dialog:default",
                        "updater:default",
                        "updater:allow-check",
                        "updater:allow-download-and-install",
                        "process:default",
                        "process:allow-restart",
                        "clipboard-manager:allow-write-text",
                        "clipboard-manager:allow-read-text",
                        "drag:default"
                    ]
}
