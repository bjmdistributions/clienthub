{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brokr",
  "version": "0.14.7",
  "identifier": "com.bjmdistributions.clienthub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Brokr",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": ["icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "assets/*": "./"
    },
    "category": "Productivity",
    "shortDescription": "Client management, email newsletters, and invoicing",
    "longDescription": "Local-first desktop app for client tracking, AI-assisted email replies, and PDF invoice generation, with peer-to-peer sync across your devices."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bjmdistributions/clienthub/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzQ0I2M0Y4REYzMUIyMUMKUldRY3NqSGYrR1BMNDdobWhHZWx3L1liRGtuWGF5cnNxaGF6SFUxV29ZRG4vcitWL3Jma2lCS0UK"
    }
  }
}
