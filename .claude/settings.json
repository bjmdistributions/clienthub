{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(shred *)",
      "Bash(dd of=*)",
      "PowerShell(Remove-Item -Recurse*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-C:/Users/Jack/Desktop/BUSINESS APP}/.claude/hooks/no-erase.sh\"",
            "timeout": 10,
            "statusMessage": "Checking never-erase rule"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-C:/Users/Jack/Desktop/BUSINESS APP}/.claude/hooks/vault-snapshot.sh\"",
            "timeout": 20,
            "statusMessage": "Snapshotting project brain"
          }
        ]
      }
    ]
  }
}
